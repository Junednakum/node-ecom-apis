# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/node-ecom"

# JWT configuration
JWT_SECRET="a_very_strong_random_secret_for_access_token_generation_123456"
JWT_REFRESH_SECRET="another_very_strong_random_secret_for_refresh_token_generation_7890"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# CORS settings
CORS_ORIGIN="http://localhost:3000"

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=no-reply@ecommerce.local
